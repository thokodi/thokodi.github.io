<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.thokodi"
       name="Thokodi"
       version="1.1.0"
       provider-name="thokodi">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>

  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>

  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Thokodi build installer</summary>
    <description lang="en_GB">A manifest-driven Kodi build installer.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
